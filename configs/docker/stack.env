# Image References
VBOGS_TORCH_IMAGE=oakleyth/vbogs-torch:1.0
VBOGS_PREPROCESS_IMAGE=oakleyth/vbogs-preprocess:1.0
VBOGS_JAX_IMAGE=oakleyth/vbogs-jax:1.0
VBOGS_VBGS_RENDER_IMAGE=oakleyth/vbogs-vbgs-render:1.0
VBOGS_PIPELINE_IMAGE=oakleyth/vbogs-pipeline:1.0

# Default Pipeline config
VBOGS_PIPELINE_CONFIG=configs/pipeline/portainer.yaml

# Dataset volumes (external Docker volumes)
VBOGS_DATASETS_VOLUME=KITTI-360
VBOGS_NVIDIA_NCORE_VOLUME=NVIDIA-PhysicalAI-AV-NCore
VBOGS_DJI_OSMO360_VOLUME=DJI-Osmo360

# KITTI-360 drive id.
VBOGS_DRIVE=2013_05_28_drive_0007_sync

# File Browser
VBOGS_FILEBROWSER_IMAGE=filebrowser/filebrowser:v2-s6
VBOGS_FILEBROWSER_HOST_BIND=0.0.0.0
VBOGS_FILEBROWSER_HOST_PORT=8088
VBOGS_FILEBROWSER_PUID=0
VBOGS_FILEBROWSER_PGID=0

# Realtime viewer
VBOGS_RENDER_VIEWER_HOST_BIND=0.0.0.0
VBOGS_RENDER_VIEWER_HOST_PORT=8071
