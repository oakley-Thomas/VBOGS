# Portainer / Docker Compose environment defaults for the pull-only deployment.
# Use with docker/compose/portainer.yml, or paste the same key/value pairs into
# the Portainer stack environment variables UI.

VBOGS_TORCH_IMAGE=oakleyth/vbogs-torch@sha256:3c33e88a1772434e7c67b52838a6a379b08d283612763d0263f72c939a361ccb
VBOGS_JAX_IMAGE=oakleyth/vbogs-jax@sha256:f1a9774315e25757e84ef0ebcf27a54d8a761ac161d99a408130cae6325cea3a
# Keep the lightweight orchestration image tag-based so Portainer can pull the
# latest runner changes after publishing without rebuilding the Torch/JAX images.
VBOGS_PIPELINE_IMAGE=oakleyth/vbogs-pipeline:latest

# KITTI-360 drive id.
VBOGS_DRIVE=2013_05_28_drive_0007_sync

# Docker-managed dataset volume used by docker/compose/portainer.yml. Other
# stage-artifact volumes are compose-managed and do not need host paths.
VBOGS_DATASETS_VOLUME=KITTI-360
# Optional NVIDIA PhysicalAI AV NCore volume for nvidia_ncore pipeline profiles.
VBOGS_NVIDIA_NCORE_VOLUME=NVIDIA-PhysicalAI-AV-NCore

# Pipeline config used by container-side run commands and manual uploads.
VBOGS_PIPELINE_CONFIG=configs/pipeline/portainer.yaml

# Optional Google Drive upload after a successful autorun. The pipeline image
# uses rclone and uploads the curated zip at outputs/v1_0/<drive>.zip.
# Share the private Drive folder with the service-account email, then set the
# folder id and credentials below in Portainer's environment UI.
VBOGS_GDRIVE_UPLOAD=0
VBOGS_GDRIVE_REMOTE=vbogs_gdrive
VBOGS_GDRIVE_DEST=
#VBOGS_GDRIVE_FOLDER_ID=
#VBOGS_GDRIVE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account",...}
#VBOGS_GDRIVE_SERVICE_ACCOUNT_FILE=/run/secrets/vbogs-google-drive-service-account.json
#VBOGS_GDRIVE_DRY_RUN=1

# File Browser sidecar for read-only project and artifact access.
VBOGS_FILEBROWSER_IMAGE=filebrowser/filebrowser:v2-s6
VBOGS_FILEBROWSER_HOST_BIND=0.0.0.0
VBOGS_FILEBROWSER_HOST_PORT=8088
# Set when serving behind a reverse proxy subpath, for example /vbogs-files.
#VBOGS_FILEBROWSER_BASE_URL=
# Override only if the File Browser database/config volumes need a different UID/GID.
#VBOGS_FILEBROWSER_PUID=1000
#VBOGS_FILEBROWSER_PGID=1000

# Browser viewer served from vbogs-vbgs-render. The viewer process still needs
# to be started with scripts/view_octree_anygs.py inside the container.
VBOGS_RENDER_VIEWER_HOST_BIND=0.0.0.0
VBOGS_RENDER_VIEWER_HOST_PORT=8071

# Example full v1.0 run from inside vbogs-pipeline after the checkout is bootstrapped:
# scripts/run_pipeline.sh --config configs/pipeline/portainer.yaml \
#   --gpu 0 --jax-device 0 --start-at prepare --stop-after bundle
